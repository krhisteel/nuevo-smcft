# Cadena de conexión PostgreSQL (Neon, Supabase, Vercel Postgres, local...)
# Si se deja vacía, la API usa una base embebida (PGlite) guardada en ./.data
DATABASE_URL=

# Clave para firmar los tokens JWT (obligatoria en producción)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta

# Duración del token en milisegundos (24 h por defecto)
JWT_EXPIRATION_MS=86400000
