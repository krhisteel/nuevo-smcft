# ---------------- Oracle Database (Oracle Cloud) ----------------
# Usuario/esquema donde se ejecutó database/oracle/schema.sql
ORACLE_USER=
ORACLE_PASSWORD=
# Cadena de conexión. Ejemplos:
#   host:1521/servicio
#   (description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-santiago-1.oraclecloud.com))(connect_data=(service_name=xxxx_smcft_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
ORACLE_CONNECT_STRING=
# Solo si la Autonomous Database exige mTLS (wallet): contenido de ewallet.pem y su contraseña
ORACLE_WALLET_PEM=
ORACLE_WALLET_PASSWORD=

# ---------------- Alternativa: PostgreSQL ----------------
# Si no hay ORACLE_CONNECT_STRING se usa DATABASE_URL; si tampoco hay,
# una base embebida (PGlite) en ./.data para desarrollo local.
DATABASE_URL=

# ---------------- Seguridad ----------------
# Clave para firmar los tokens JWT (obligatoria en producción)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta
# Duración del token en milisegundos (24 h por defecto)
JWT_EXPIRATION_MS=86400000
