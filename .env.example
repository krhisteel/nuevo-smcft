# ---------------- Oracle Database (Oracle Cloud, esquema SMCFT) ----------------
# Usuario y contraseña con que se conecta la página (normalmente SMCFT)
ORACLE_USER=SMCFT
ORACLE_PASSWORD=
# Cadena de conexión TLS del servicio _low de la Autonomous Database. Ejemplo:
# (description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-santiago-1.oraclecloud.com))(connect_data=(service_name=xxxx_smcftdb_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
ORACLE_CONNECT_STRING=
# Esquema donde están las tablas (por defecto SMCFT)
ORACLE_SCHEMA=SMCFT
# Solo si la base exige mTLS (wallet): contenido completo de ewallet.pem y su contraseña
ORACLE_WALLET_PEM=
ORACLE_WALLET_PASSWORD=

# ---------------- Seguridad ----------------
# Clave para firmar las sesiones (JWT). Obligatoria en producción.
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta
# Duración de la sesión en milisegundos (24 h por defecto)
JWT_EXPIRATION_MS=86400000
